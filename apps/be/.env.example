# ========================================
# ENVIRONMENT & SERVER
# ========================================
NODE_ENV=development
PORT=3030

# ========================================
# DATABASE (PostgreSQL)
# ========================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_restaurant
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=smart_restaurant

# ========================================
# CACHE & IN-MEMORY (Redis)
# ========================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# TTL Settings (seconds)
REDIS_MENU_PUBLIC_TTL=300
REDIS_MENU_GUEST_TTL=300
REDIS_MENU_TOPCHEF_TTL=300
REDIS_DASHBOARD_TTL=60

# Distributed Locks
REDIS_DASHBOARD_LOCK_TTL_MS=8000
REDIS_DASHBOARD_LOCK_WAIT_MS=50
REDIS_DASHBOARD_LOCK_RETRIES=6

TABLE_SESSION_TTL_SECONDS=10800
TABLE_SESSION_HEARTBEAT_TTL_SECONDS=120
TABLE_SESSION_LOCK_TTL_MS=8000
TABLE_SESSION_LOCK_WAIT_MS=50
TABLE_SESSION_LOCK_RETRIES=6

# ========================================
# AUTHENTICATION & SECRETS (JWT, QR)
# ========================================
JWT_ACCESS_SECRET=smart_restaurant_jwt_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=smart_restaurant_jwt_refresh_secret_super_secure_key_2026
JWT_EXPIRES_IN=7d
QR_SECRET=smart_restaurant_qr_token_secret_salt_2026

# Google OAuth
GOOGLE_CLIENT_ID=134540927147-avuem4p7a41e2iddu2jqcvq2asl7vhqv.apps.googleusercontent.com

# ========================================
# CORS & URLS
# ========================================
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:3030
ALLOWED_ORIGINS=http://localhost:5173,https://smart-restaurant.id.vn

# ========================================
# AI SOMMELIER (GEMINI API)
# ========================================
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# If left empty, system runs gracefully in deterministic hybrid mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ========================================
# EMAIL (Resend / Nodemailer)
# ========================================
RESEND_API_KEY=
MAIL_FROM=no-reply@smart-restaurant.id.vn

# ========================================
# CLOUDINARY (Media Storage)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================
# STRIPE PAYMENT INTEGRATION
# ========================================
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ========================================
# RATE LIMITING
# ========================================
RL_LOGIN_WINDOW_SECONDS=60
RL_LOGIN_IP_LIMIT=20
RL_LOGIN_EMAIL_LIMIT=10
RL_FORGOT_WINDOW_SECONDS=60
RL_FORGOT_LIMIT=5
RL_RESEND_WINDOW_SECONDS=60
RL_RESEND_LIMIT=5
